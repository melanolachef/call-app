# Copie para .env (que não vai para o git) ou configure no Fly.io com
# `fly secrets set NOME=valor`. Todas são opcionais.

# Porta HTTP (padrão 3000) e pessoas por sala (padrão 12).
PORT=3000
MAX_PEERS=12

# TURN da Cloudflare Realtime, para quem não conecta direto (VPN, 4G, rede de
# empresa). Crie a chave no painel da Cloudflare: Realtime > TURN Server >
# Create. Sem estas duas, o app usa só STUN.
TURN_KEY_ID=
TURN_KEY_API_TOKEN=

# Busca de GIFs no chat (KLIPY). Sem chave, a aba de GIFs não aparece.
GIF_API_KEY=

# Apoio voluntário por Pix (página /apoiar e link no início). Sem PIX_KEY,
# a página diz que o apoio não está aberto e o link some. Chave de celular
# no formato +5511999999999. Nome e cidade aparecem no app do banco.
PIX_KEY=
PIX_NAME=
PIX_CITY=

# Contas opcionais com Google (docs/CONTAS.md). Sem as quatro, o app funciona
# sem contas, como antes. O banco é um arquivo SQLite (no Fly, num volume).
DATABASE_PATH=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
PUBLIC_URL=http://localhost:3000
# GIF_API_BASE=https://api.klipy.com
