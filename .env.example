# Copie para .env (que não vai para o git) ou configure no Fly.io com
# `fly secrets set NOME=valor`. Todas são opcionais.

# Porta HTTP (padrão 3000) e pessoas por sala (padrão 12).
PORT=3000
MAX_PEERS=12

# TURN da Cloudflare Realtime, para quem não conecta direto (VPN, 4G, rede de
# empresa). Crie a chave no painel da Cloudflare: Realtime > TURN Server >
# Create. Sem estas duas, o app usa só STUN.
TURN_KEY_ID=
TURN_KEY_API_TOKEN=

# Busca de GIFs no chat (KLIPY). Sem chave, a aba de GIFs não aparece.
GIF_API_KEY=
# GIF_API_BASE=https://api.klipy.com
